{
  "name": "Rocket Print (démo)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "forwardPorts": [3300, 3301],
  "portsAttributes": {
    "3300": { "label": "Rocket Print", "onAutoForward": "notify" },
    "3301": { "label": "Documentation et changelog", "onAutoForward": "notify" },
    "8300": { "label": "API", "onAutoForward": "silent" },
    "5432": { "onAutoForward": "ignore" }
  },
  "postStartCommand": "bash demo/codespaces/start.sh"
}
